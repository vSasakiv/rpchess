// v = vertex position
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

//vt = tecxture coordinate
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

//vn = vertex nornal
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# front face
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1

# back face
f 6/1/2 5/2/2 8/3/2
f 6/1/2 8/3/2 7/4/2

# right face
f 2/1/3 6/2/3 7/3/3
f 2/1/3 7/3/3 3/4/3

# left face
f 5/1/4 1/2/4 4/3/4
f 5/1/4 4/3/4 8/4/4

# top face
f 4/1/5 3/2/5 7/3/5
f 4/1/5 7/3/5 8/4/5

# bottom face
f 5/1/6 6/2/6 2/3/6
f 5/1/6 2/3/6 1/4/6